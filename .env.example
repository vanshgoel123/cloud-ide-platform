# ============================================================
#  Cloud IDE Platform — environment configuration
#  Copy this file to .env and fill in the values.
# ============================================================

# ── Public domain ────────────────────────────────────────────
# Used to build workspace URLs: http://<DOMAIN>/ws/<id>/
# Use "localhost" for local dev, or your real domain in production.
DOMAIN=localhost

# ── Service ports ────────────────────────────────────────────
# Port the Nginx frontend listens on (the one you open in the browser).
WEB_PORT=80

# Port the FastAPI backend listens on (only needed for direct debug access;
# normal traffic goes through Nginx).
API_PORT=8000

# ── code-server container settings ───────────────────────────
# Docker image for VS Code workspaces.
VS_IMAGE=codercom/code-server:latest

# CPU and memory limits per workspace container.
VS_CPU_LIMIT=0.5
VS_MEM_LIMIT=512m

# Minutes of inactivity before a workspace is automatically stopped.
VS_IDLE_TIMEOUT_MIN=30

# NOTE: There is no VS_PASSWORD anymore.
# Each workspace gets its own unique password (the token returned at creation).
# Store it somewhere safe — it is shown only once.

# ── API authentication ────────────────────────────────────────
# Optional static API key for mutation endpoints (create/start/stop/delete).
# Leave empty to disable auth (fine for local dev, not for production).
API_KEY=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * to allow all.
CORS_ALLOW_ORIGINS=*

# ── Rate limiting (workspace creation) ───────────────────────
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_CREATE_PER_WINDOW=5
